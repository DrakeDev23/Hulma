# ─── Application ─────────────────────────────────
APP_NAME="Hulma API"
APP_ENV=production
DEBUG=false
# Local/dev only. Must stay false in production. Requires APP_ENV=development|dev|local|test.
ALLOW_DEV_TOKENS=false
# Set true only behind a reverse proxy that overwrites X-Forwarded-For / X-Real-IP.
TRUST_PROXY_HEADERS=false

# ─── Database ────────────────────────────────────
DATABASE_URL=postgresql+psycopg://hulmauser:CHANGE_ME@db:5432/hulma
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ─── Security ────────────────────────────────────
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_SECRET

# ─── CORS ────────────────────────────────────────
CORS_ORIGINS=https://hulma.vercel.app
CORS_ORIGIN_REGEX=^https://hulma(-git-[a-z0-9-]+)?-drakedev23s-projects\.vercel\.app$
ALLOWED_ORIGINS=https://hulma.vercel.app

# ─── Clerk Auth ──────────────────────────────────
CLERK_ISSUER=https://super-malamute-71.clerk.accounts.dev
CLERK_JWKS_URL=https://super-malamute-71.clerk.accounts.dev/.well-known/jwks.json
# Optional. Default Clerk session tokens from getToken() do NOT include `aud`.
# Authorized-party checks use `azp` against ALLOWED_ORIGINS / CORS_ORIGINS.
# Only set these when using a Clerk JWT template that emits `aud`:
#   CLERK_AUDIENCE=https://hulma-api
#   REQUIRE_CLERK_AUDIENCE=true
# and frontend getToken({ template: 'your-template-name' }).
CLERK_AUDIENCE=
REQUIRE_CLERK_AUDIENCE=false

# ─── AI Provider ─────────────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=
AI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AI_PROVIDER=groq

# ─── Supabase Storage ────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=portfolio-images
MAX_IMAGE_SIZE_MB=7
# Optional total multipart body ceiling in MB (defaults to MAX_IMAGE_SIZE_MB + 0.5).
# MAX_MULTIPART_BODY_MB=8
MAX_IMAGE_DIMENSION_PX=8192
