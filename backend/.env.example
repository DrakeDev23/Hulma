# ─── Application ─────────────────────────────────
APP_NAME="Hulma API"
APP_ENV=production
DEBUG=false

# ─── Database ────────────────────────────────────
DATABASE_URL=postgresql+psycopg://hulmauser:CHANGE_ME@db:5432/hulma
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ─── Security ────────────────────────────────────
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_SECRET

# ─── CORS ────────────────────────────────────────
CORS_ORIGINS=https://hulma.vercel.app,http://localhost:5173
CORS_ORIGIN_REGEX=https://hulma(-git-.*)?-drakedev23s-projects\.vercel\.app

# ─── Clerk Auth ──────────────────────────────────
CLERK_ISSUER=https://super-malamute-71.clerk.accounts.dev
CLERK_JWKS_URL=https://super-malamute-71.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=

# ─── AI Provider ─────────────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=
AI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AI_PROVIDER=groq

# ─── Supabase Storage ────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=portfolio-images
MAX_IMAGE_SIZE_MB=7
